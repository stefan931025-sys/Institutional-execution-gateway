import asyncio
import logging
from fix_handler import FIXHandler

logger = logging.getLogger("InstitutionalGateway")

class RiskError(Exception):
    """Raised when an order breaches pre-trade risk boundaries."""
    pass

class PreTradeRiskEngine:
    """Enforces real-time pre-trade risk checks (notional limits, size caps, velocity)."""
    def __init__(self, max_notional: float = 1000000.0, max_mw_size: float = 50.0):
        self.max_notional = max_notional
        self.max_mw_size = max_mw_size

    def check_order(self, notional: float, mw_size: float):
        if notional > self.max_notional:
            raise RiskError(f"Order rejected: Notional {notional} exceeds max limit {self.max_notional}")
        if mw_size > self.max_mw_size:
            raise RiskError(f"Order rejected: MW size {mw_size} exceeds limit {self.max_mw_size}")
        return True

class InstitutionalGateway:
    """Orchestrates low-latency connectivity, pre-trade risk compliance, and execution routing."""
    def __init__(self, host: str, port: int, sender_comp_id: str, target_comp_id: str):
        self.fix_handler = FIXHandler(host, port, sender_comp_id, target_comp_id)
        self.risk_engine = PreTradeRiskEngine()
        self.kill_switch_active = False

    async def start(self):
        """Initializes underlying FIX connection and session loop."""
        await self.fix_handler.connect()

    async def submit_order(self, cl_ord_id: str, symbol: str, side: str, qty: float, price: float):
        """Processes order through pre-trade risk controls before dispatching over FIX."""
        if self.kill_switch_active:
            logger.error("MASTER KILL SWITCH IS ACTIVE. Order execution blocked.")
            return

        notional = qty * price
        
        try:
            self.risk_engine.check_order(notional, qty)
        except RiskError as e:
            logger.error(f"Risk Check Failed: {e}")
            return

        await self.fix_handler.send_order(cl_ord_id, symbol, side, qty, price)

    def activate_kill_switch(self):
        """Instantly engages the emergency master kill switch."""
        self.kill_switch_active = True
        logger.critical("EMERGENCY: Master Kill Switch activated!")

    async def stop(self):
        """Gracefully tears down the gateway session."""
        await self.fix_handler.close()
